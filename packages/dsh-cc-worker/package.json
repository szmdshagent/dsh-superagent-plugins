{
  "name": "dsh-cc-worker",
  "version": "0.1.1",
  "description": "给 dsh agent 一双能真正干活的手：把脚本、构建、测量、批量改动交给 Claude Code 执行。自带执行器，无需外部脚本即可运行。",
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    }
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "manifestVersion": 1
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "claude-code",
    "agent"
  ],
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.5-alpha.1",
    "@types/node": "22.20.0",
    "tsdown": "0.22.14",
    "typescript": "6.0.3",
    "zod": "4.6.7"
  }
}