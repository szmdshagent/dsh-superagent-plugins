#!/bin/bash
# cc-worker —— superagent worker 的 Claude Code 执行器（"手脚"）。
# 用户已明确同意：无头模式跳过权限审批（--dangerously-skip-permissions），仅限 VM 内、szm 用户。
# 把一条任务交给无头模式的 Claude Code（VM 上的 claude CLI）执行：
#   会话 id 由本脚本预分配并立即落盘（.cc-worker/session_id），因此即使进程被杀/超时，
#   之后同一目录的调用仍能 --resume 续跑；resume 目标不存在时自动回退为新开会话。
#   完整事件流写入 <dir>/.cc-worker/log.jsonl；stdout 只输出一行 JSON 结果。
# 用法：
#   cc-worker run "任务描述" [--dir DIR] [--new] [--model NAME] [--timeout SECONDS] [--max-turns N] [--prompt-file FILE] [--hard-budget-gate]
#   结果 JSON：{"ok":true,"result":"...","session_id":"...","cost_usd":...,"duration_s":...,"log":"..."}
set -u

# --- GitHub over SSH（2026-11-06 注入；备份 cc-worker.bak-gitssh-*）---
# 背景：dsh 生成的 worker-gitconfig 里有 url."https://github.com/".insteadOf=git@github.com:，
# 会把 SSH 地址反向改写成 HTTPS；但本机 HTTPS 到 github.com 被 GnuTLS 干扰（recv error -54），
# SSH 才是唯一可用通道。这里用 GIT_CONFIG_COUNT 追加一条更高优先级的 insteadOf，
# 把 https://github.com/ 重写回 git@github.com:，覆盖 worker-gitconfig 里的反规则。
# 只影响本进程及其子进程；不改 dsh 源码、不改 worker-gitconfig（它每次派活都会重写）。
if [ -n "${GIT_CONFIG_GLOBAL:-}" ]; then
  GIT_CONFIG_COUNT=1
  GIT_CONFIG_KEY_0='url.git@github.com:.insteadOf'
  GIT_CONFIG_VALUE_0='https://github.com/'
  export GIT_CONFIG_COUNT GIT_CONFIG_KEY_0 GIT_CONFIG_VALUE_0
fi
# --- 注入结束 ---
PROMPT=""; DIR=""; NEW=0; MODEL="deepseek"; TMO="1800"
# team 子命令（2026-11-11）：统筹 -> 并行 -> 汇总。缺省关闭，行为与旧版一致。
MODE_TEAM=0; TEAM_WORKERS=3
# 协作 lane：缺省 main = 旧行为（状态文件就在 $DIR/.cc-worker 下）。
# 传 --lane w1 时状态文件落到 $DIR/.cc-worker/lanes/w1，锁与会话各自独立，可与其它 lane 并行。
# --task "一句话分工" 只是登记用途（写 $BASE/task.txt），面板会把它显示在这张工单的分工列表里；不影响执行。
# 协作 lane 的命名规范：ccw1、ccw2、ccw3…（面板显示同名；旧的 w1/w2 会显示成 ccw1/ccw2）。
# 2026-11-11 加：为「一张工单多 worker 协作」铺路；不加此参数时行为不变。
LANE="${CC_LANE:-main}"
# 轮次预算：默认兜底 120 轮，拦住失控的长会话（实测有工单跑到 567 轮）。
# 但有些任务天然连贯、切分即失效（探索性排查、必须连续观察的调试、目标尚未成形），
# 这类任务用 --max-turns unlimited 显式放行，且必须用 --why 写明理由；
# 理由会落进结果 JSON，事后可审计该不该放行，而不是靠模型自说自话。
MAXTURNS="120"
TURNS_UNLIMITED=0
WHY=""
# 上下文警戒线：只告警、不直接换会话；真正的换会话由 decide.py 在 resume 前判定。
# 267000 = AUTO_COMPACT_WINDOW(254000) x 1.05：必须高于压缩触发点，否则健康会话
# 在压缩之前就必然先告警（2026-11-04 审计实测：3 次告警全部命中饱和值、同一工单 5 分钟 3 连报）。
# 2026-11-06 起 decide.py 的兜底阈值：会话文件 >=20MB、上一轮 cache_read >=80万、
# 或 assignments >5 就换会话；>=50MB 强制换。压缩生效时仍可续跑，压缩没触发时由这些阈值兜底。
MAX_CONTEXT_TOKENS="267000"
# 预算闸门（2026-11-04，2026-11-06 调整）：默认只观测、不阻断。
# 模型自预估不可靠：3 组真实短任务 A/B 没有可测 token 节省，反而增加固定开销/误杀。
# 现在：计划可选、只记录；硬闸门只保留“同一工具调用重复第 3 次”+ 超时/--max-turns。
# 需要原来的强制预估：加 --hard-budget-gate；--no-budget-gate 可完全关闭。
BUDGET_GATE=1
HARD_GATE="${HARD_GATE:-0}"
ALLOW_RESUME=1
# 必须显式给 --dir：所有工单共用 $PWD 会让不同工单的 Claude Code 会话串味，
# 面板按工单目录找 .cc-worker 也就永远读不到。
REQUIRE_DIR=1
case "${1:-}" in
  run) shift;;
  team) MODE_TEAM=1; shift;;
esac
while [ $# -gt 0 ]; do
  case "$1" in
    --dir) DIR="$2"; shift 2;;
    --new) NEW=1; shift;;
    --model) MODEL="$2"; shift 2;;
    --timeout) TMO="$2"; shift 2;;
    --max-turns) MAXTURNS="$2"; shift 2;;
    --why) WHY="$2"; shift 2;;
    --max-context-tokens) MAX_CONTEXT_TOKENS="$2"; shift 2;;
    --no-resume) ALLOW_RESUME=0; shift;;
    --lane) LANE="$2"; shift 2;;
    --workers) TEAM_WORKERS="$2"; shift 2;;
    --task) TASK="$2"; shift 2;;
    --no-budget-gate) BUDGET_GATE=0; shift;;
    --hard-budget-gate) HARD_GATE=1; shift;;
    --prompt-file) PROMPT="$(cat -- "$2" 2>/dev/null)"; shift 2;;
    -*) shift;;
    *) PROMPT="${PROMPT:+$PROMPT }$1"; shift;;
  esac
done
if [ -z "$PROMPT" ]; then echo '{"ok":false,"error":"empty prompt"}'; exit 2; fi
# 没给 --dir 就拒绝：绝不回落到 $PWD，否则会话会串到别的工单去。
if [ -z "$DIR" ]; then
  echo '{"ok":false,"error":"missing --dir: pass the ticket directory, e.g. --dir /home/szm/.dsh/state/superagent/work/<ticket>"}'
  exit 2
fi
case "$DIR" in
  /home/szm/.dsh/state/superagent/work/*) ;;
  *) echo "{\"ok\":false,\"error\":\"--dir must be a ticket directory under /home/szm/.dsh/state/superagent/work, got: $DIR\"}"; exit 2;;
esac
# lane 名只允许安全字符：它会拼进路径，绝不能带 / 或 ..
case "$LANE" in
  ""|*[!A-Za-z0-9_-]*) echo '{"ok":false,"error":"invalid --lane: use letters, digits, - and _ only"}'; exit 2;;
esac
# 状态根：main 与旧版完全一致；其它 lane 各占一个子目录。
CCROOT="$DIR/.cc-worker"
if [ "$LANE" = "main" ]; then BASE="$CCROOT"; else BASE="$CCROOT/lanes/$LANE"; fi
# 导出给子进程（decide.py 靠它构造自己的状态路径），必须与 $BASE 口径一致。
export CC_LANE="$LANE"
mkdir -p "$BASE/runs" || { echo '{"ok":false,"error":"bad dir"}'; exit 2; }
# 分工登记（面板展示用）：只写不改执行逻辑；任务描述里有换行就压成一行。
if [ -n "${TASK:-}" ]; then
  printf '%s\n' "$(printf '%s' "$TASK" | tr '\n' ' ')" > "$BASE/task.txt" 2>/dev/null || true
fi

# === team 子命令：统筹 -> 并行 -> 汇总（2026-11-11 第二步）===
if [ "$MODE_TEAM" = "1" ]; then
  # 嵌套保护：team 里再调 team 会指数膨胀
  if [ "${CC_TEAM_DEPTH:-0}" -ge 1 ]; then
    echo '{"ok":false,"error":"team cannot be nested (CC_TEAM_DEPTH already set)"}'; exit 2
  fi
  export CC_TEAM_DEPTH=1
  SELF="$(readlink -f "$0")"
  case "$TEAM_WORKERS" in
    ''|*[!0-9]*) TEAM_WORKERS=3;;
  esac
  [ "$TEAM_WORKERS" -lt 1 ] 2>/dev/null && TEAM_WORKERS=1
  [ "$TEAM_WORKERS" -gt 4 ] 2>/dev/null && TEAM_WORKERS=4

  PLAN="$CCROOT/team-plan.json"
  LEAD_BASE="$CCROOT/lanes/lead"
  SHARED="$CCROOT/shared"
  # 两层共享：工单内（shared/findings）与全局（跨工单可复用知识）。
  GLOBAL_SHARED="$HOME/.dsh/state/superagent/shared/knowledge"
  mkdir -p "$SHARED/findings" "$SHARED/artifacts" "$GLOBAL_SHARED" 2>/dev/null || true
  rm -f "$PLAN"

  echo "[team] 阶段1/3 统筹：拆解任务（lead lane，最多 $TEAM_WORKERS 个子任务）" >&2
  "$SELF" run "你是统筹 worker。总任务如下：

$PROMPT

请把任务拆成最多 $TEAM_WORKERS 个**互不依赖、可并行**的子任务。要求：
1. 每个子任务写清：做什么、验收标准、禁止触碰的范围（避免两个 worker 改同一文件）。
2. 用 Write 工具把计划写到 $PLAN，内容必须是 JSON 数组，元素形如：
   [{\"lane\":\"ccw1\",\"task\":\"子任务描述（含验收与禁止事项）\"}, {\"lane\":\"ccw2\",\"task\":\"...\"}]
   其中 lane 依次用 ccw1、ccw2、ccw3…（最多 $TEAM_WORKERS 个）。
3. 如果任务确实不可拆分（强依赖、探索性、必须连续观察），就写一个空数组 []。
4. 写完后只回答 PLAN_DONE，不要自己执行子任务。

工单内共享区：$SHARED（findings/ 可写中间结论，artifacts/ 可登记产物路径）。" \
    --dir "$DIR" --lane lead --max-turns 12 --timeout 600 >/dev/null 2>&1

  # 解析计划：每行 "lane<TAB>task"
  PLAN_TSV="$(python3 -c '
import json, sys, re
try:
    data = json.load(open(sys.argv[1], encoding="utf-8"))
except Exception:
    sys.exit(0)
if not isinstance(data, list):
    sys.exit(0)
for item in data[:8]:
    if not isinstance(item, dict):
        continue
    lane = str(item.get("lane") or "").strip()
    task = str(item.get("task") or "").replace("\n", " ").strip()
    if not re.fullmatch(r"[A-Za-z0-9_-]+", lane) or not task:
        continue
    print(lane + "\t" + task)
' "$PLAN" 2>/dev/null)"

  if [ -z "$PLAN_TSV" ]; then
    echo "[team] 计划为空或解析失败 -> 降级为单 worker 直跑" >&2
    exec "$SELF" run "$PROMPT" --dir "$DIR" --lane main --max-turns "$MAXTURNS" --timeout "$TMO"
  fi

  echo "[team] 阶段2/3 并行执行：" >&2
  echo "$PLAN_TSV" | while IFS="$(printf '\t')" read -r L T; do
    [ -z "$L" ] && continue
    echo "  - $L: $T" >&2
  done

  PIDS=""
  i=0
  while IFS="$(printf '\t')" read -r L T; do
    [ -z "$L" ] && continue
    i=$((i + 1))
    # 关键：重定向在 exec 之前求值，目录必须先存在，否则子进程根本起不来（2026-11-11 实测）。
    mkdir -p "$CCROOT/lanes/$L" 2>/dev/null || true
    "$SELF" run "$T

工单内共享区：$SHARED。开始前可读 $SHARED/findings/ 避免重复劳动；
完成或卡住时写一条 $SHARED/findings/$L.md（DONE/BLOCKED + 一句结论）。
全局知识库：$GLOBAL_SHARED（跨工单）。只读，先看 index.md，只挑与本任务相关的条目，不要全量读。
本任务产出了可复用的结论时，追加一行到 $GLOBAL_SHARED/index.md，并在同名 .md 里写正文。" \
      --dir "$DIR" --lane "$L" --task "$T" --timeout "$TMO" --max-turns "$MAXTURNS" \
      > "$CCROOT/lanes/$L/result.json" 2>"$CCROOT/lanes/$L/stderr.log" &
    PIDS="$PIDS $!"
  done <<< "$PLAN_TSV"

  # 零 token 监督：轮询判活 + 超时强杀，不经过模型。
  DEADLINE=$(( $(date +%s) + TMO ))
  while :; do
    ALIVE=0
    for pid in $PIDS; do kill -0 "$pid" 2>/dev/null && ALIVE=$((ALIVE + 1)); done
    [ "$ALIVE" -eq 0 ] && break
    if [ "$(date +%s)" -ge "$DEADLINE" ]; then
      echo "[team] 超时(${TMO}s)：终止剩余 $ALIVE 路 lane" >&2
      for pid in $PIDS; do kill -TERM "$pid" 2>/dev/null; done
      sleep 5
      for pid in $PIDS; do kill -KILL "$pid" 2>/dev/null; done
      break
    fi
    sleep 5
  done
  FAILED=0
  for pid in $PIDS; do
    wait "$pid" 2>/dev/null || FAILED=$((FAILED + 1))
  done
  echo "[team] 并行完成：$i 路，失败 $FAILED 路" >&2

  # 冲突检测：各 lane「改动文件」段落里的路径若重叠，写进 conflicts.md 交给统筹裁决。
  python3 "$HOME/cc-diag/team_conflicts.py" "$CCROOT" 2>/dev/null || true

  echo "[team] 阶段3/3 汇总（resume lead，读全部 lane 交接）" >&2
  COLLECT=""
  while IFS="$(printf '\t')" read -r L T; do
    [ -z "$L" ] && continue
    HF="$CCROOT/lanes/$L/handoff.md"
    COLLECT="$COLLECT

===== $L（任务：$T）=====
$(cat "$HF" 2>/dev/null || echo '（无交接单）')"
  done <<< "$PLAN_TSV"

  "$SELF" run "各子 worker 已全部结束。以下是它们的交接单，请汇总成一个协调一致的结果：

$COLLECT

$(if [ -s "$SHARED/conflicts.md" ]; then echo "===== 自动冲突检测 ====="; cat "$SHARED/conflicts.md"; fi)

要求：
1. 冲突或矛盾由你裁决，并说明依据（上面「自动冲突检测」里的重叠路径优先处理）。
2. 有 worker 失败/无交接的，明确标出缺口。
3. 最终给出一份统一结论，写入工单共享区 $SHARED/findings/final.md。" \
    --dir "$DIR" --lane lead --max-turns 20 --timeout 900 \
    > "$CCROOT/team-summary.json" 2>"$CCROOT/team-summary.err"

  echo "[team] 完成。汇总结果：$CCROOT/team-summary.json" >&2
  cat "$CCROOT/team-summary.json" 2>/dev/null || echo '{"ok":false,"error":"summary missing"}'
  exit 0
fi
cd "$DIR" || exit 2
LOG="$BASE/log.jsonl"; SIDF="$BASE/session_id"; ERRF="$BASE/stderr.log"
# 同一 lane 串行执行：拿到锁才跑（最多等 600 秒），防两个进程并发写同一 Claude Code 会话。
# 锁按 lane 独立：不同 lane 各拿自己的锁，因此可以并行；同 lane 仍然串行。
exec 9>"$BASE/lock"
flock -w 600 9 || { echo "{\"ok\":false,\"error\":\"another cc-worker is running in lane ${LANE} (waited 600s)\"}"; exit 3; }
RUNLOG="$BASE/runs/$(date +%Y%m%d-%H%M%S).jsonl"
# 反馈边：把历史上「实际/预估」的中位倍率算出来，写进下一次的提示词。
BUDGET_LEDGER="$BASE/budget-ledger.jsonl"
BUDGET_GLOBAL="$HOME/.dsh/state/superagent/budget-ledger.jsonl"
BUDGET_CALIB=""
if [ "$BUDGET_GATE" = 1 ]; then
  BUDGET_CALIB="$(python3 - "$BUDGET_LEDGER" "$BUDGET_GLOBAL" <<'PYCAL' 2>/dev/null
import json, statistics, sys
def load(path, limit):
    out = []
    try:
        for line in open(path, encoding="utf-8", errors="replace"):
            try:
                r = json.loads(line)
            except Exception:
                continue
            if r.get("plan_found") and r.get("est_steps") and r.get("act_steps") is not None:
                out.append(r)
    except Exception:
        pass
    v2 = [r for r in out if r.get("schema") == "p0-v1"]
    return (v2 if len(v2) >= 3 else out)[-limit:]

# 本工单样本优先；不足 3 条则退回全局最近 20 条，避免每个新工单从零开始。
rows = load(sys.argv[1], 8)
source = "本工单"
if len(rows) < 3 and len(sys.argv) > 2:
    rows = load(sys.argv[2], 20)
    source = "全局"
if not rows:
    print("无历史校准数据；固定开销提示：空任务实测 input 约 21K（系统提示+工具定义），预估必须计入这个底。")
else:
    sr = [r["act_steps"] / r["est_steps"] for r in rows if r.get("est_steps")]
    tr = []
    for r in rows:
        # 被硬闸门 kill 的 run 没有完整 result，token 不完整，不进入 token 倍率。
        if r.get("capped") or r.get("violation"):
            continue
        est = r.get("est_input")
        act = r.get("act_input_total")
        if act is None:
            act = (r.get("act_input") or 0) + (r.get("act_cache_read") or 0)
        if est and act:
            tr.append(act / est)
    rr = [r["context_rereads"] for r in rows
          if r.get("context_rereads") is not None and not r.get("capped")]
    out = []
    if sr:
        out.append("%s steps 实际/预估中位倍率 %.2f（%d 次）" % (source, statistics.median(sr), len(sr)))
    if tr:
        out.append("%s input_tokens（含缓存）实际/预估中位倍率 %.2f（%d 次）" % (source, statistics.median(tr), len(tr)))
    if rr:
        out.append("%s context_rereads 中位 %.2f（%d 次）" % (source, statistics.median(rr), len(rr)))
    viol = [r for r in rows if r.get("violation")]
    if viol:
        vc = {}
        for r in viol:
            vc[r["violation"]] = vc.get(r["violation"], 0) + 1
        out.append("历史硬闸门违规 %d 次（%s）；steps 宁多报勿少报，超 1.5 倍会被终止"
                   % (len(viol), "，".join("%s×%d" % (k, v) for k, v in sorted(vc.items()))))
    out.append("固定开销：空任务实测 input 约 21K（系统提示+工具定义），预估必须计入这个底")
    print("；".join(out))
PYCAL
)"
  [ -z "$BUDGET_CALIB" ] && BUDGET_CALIB="无历史校准数据。"
fi
# 后端：VM 可达的 superagent 路由器（8788，全链 deepseek）；model 名会被路由器覆盖，与配置保持一致即可。
export ANTHROPIC_BASE_URL="http://192.168.206.1:8788"
export ANTHROPIC_AUTH_TOKEN="local-router"
export ANTHROPIC_MODEL="$MODEL"
export ANTHROPIC_DEFAULT_SONNET_MODEL="$MODEL"
export ANTHROPIC_DEFAULT_OPUS_MODEL="$MODEL"
export ANTHROPIC_DEFAULT_HAIKU_MODEL="$MODEL"
export ANTHROPIC_SMALL_FAST_MODEL="$MODEL"
export CLAUDE_CODE_MAX_OUTPUT_TOKENS="32000"
# 上下文管理：直接对齐 dsh 的 compaction-basic，两个变量分工不同，缺一不可。
#   MAX_CONTEXT_TOKENS    = 声明窗口容量（dsh DEFAULT_CONTEXT_WINDOW = 262144）
#   AUTO_COMPACT_WINDOW   = 实际压缩触发点（dsh threshold = min(0.8*W, W-reserved-65536) = 202464）
# 原值 500000 无依据：CC 会把 50 万当窗口，实测 83 个会话一次都没压缩，峰值冲到 392005。
# 对齐后压缩点 163840 始终低于路由最窄上游千帆的 300000，夜间不会再被踢出千帆。
export CLAUDE_CODE_MAX_CONTEXT_TOKENS="400000"
export CLAUDE_CODE_AUTO_COMPACT_WINDOW="254000"
export DISABLE_TELEMETRY=1 DISABLE_ERROR_REPORTING=1 DISABLE_AUTOUPDATER=1
export CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC=1
BASE_ARGS=(--dangerously-skip-permissions --output-format stream-json --verbose)
# 轮次预算裁决：unlimited 显式放行，但必须留下理由；其它值作为硬上限传给 Claude Code。
case "$MAXTURNS" in
  unlimited|unlimited|none|off|0)
    TURNS_UNLIMITED=1
    if [ -z "${WHY// /}" ]; then
      echo '{"ok":false,"error":"--max-turns unlimited requires --why: state why this task cannot be split, e.g. --why \"steps depend on each other, each fix decides the next probe\""}'
      exit 2
    fi
    echo "cc-worker: turns unlimited, reason: $WHY" >&2
    ;;
  "")
    MAXTURNS="120"
    BASE_ARGS+=(--max-turns "$MAXTURNS")
    ;;
  *)
    BASE_ARGS+=(--max-turns "$MAXTURNS")
    ;;
esac
# 把裁决结果传给结果汇总脚本，写进 JSON 供事后核对估算准不准。
export CC_MAX_TURNS="$MAXTURNS"
export CC_TURNS_UNLIMITED="$TURNS_UNLIMITED"
export CC_TURNS_WHY="$WHY"

# 会话 id：预分配 + 立即落盘（进程被杀也不丢，下次可续跑）。
# 有旧 id 且非 --new 时走 resume；否则用新 id 并以 --session-id 指定创建。
# --- 上下文预算裁决：resume 之前先估这个会话现在有多长 ---------------------
# 读本工单最近两次 run 的 modelUsage.cacheReadInputTokens（会话累计），用增量 / 轮次
# 估算当前上下文大小。超过 MAX_CONTEXT_TOKENS 就把 resume 降级成新会话。
# 为什么不用累计值：累计是会话一生的总和，跑得久就越接近任何阈值，
# 会拦掉健康的长会话却放过上下文巨大的短会话，方向是错的。
if [ "$NEW" = 0 ] && [ "$ALLOW_RESUME" = 1 ] && [ -s "$SIDF" ] && [ -d "$BASE/runs" ]; then
  CTX=$(python3 - "$DIR" <<'PYCTX' 2>/dev/null
import glob, json, os, sys
d = sys.argv[1]
runs = []
for f in sorted(glob.glob(os.path.join(d, ".cc-worker", "runs", "*.jsonl")), key=os.path.getmtime):
    try:
        for line in open(f, encoding="utf-8", errors="replace"):
            if '"result"' not in line:
                continue
            r = json.loads(line)
            if r.get("type") != "result":
                continue
            cr = 0
            for mu in (r.get("modelUsage") or {}).values():
                if isinstance(mu, dict):
                    cr += mu.get("cacheReadInputTokens") or 0
            runs.append((cr, r.get("num_turns") or 0))
    except Exception:
        continue
if not runs:
    print(0)
else:
    # 上下文估算的唯一可靠来源：一次 run 的「cacheRead 增量 / 该 run 的轮次」。
    # 不能直接用累计值 cr/turns —— 会话被重置后累计归零，那个比值毫无意义。
    # 也不能用相邻 run 的差值 —— run 的轮次与它内部实际增长不线性。
    #
    # 做法：对每个 run 求「相对它之前所有 run 的最小累计值」的增量（即重启后的净增长），
    # 再除以该 run 的轮次，取所有正估计的中位数。
    ests = []
    floor_cr = 0
    for cr, t in runs:
        if cr < floor_cr:
            floor_cr = cr            # 会话被重置，累计值回落
        delta = cr - floor_cr
        if delta > 0 and t >= 3:
            ests.append(int(delta / t))
        floor_cr = max(floor_cr, cr) if cr >= floor_cr else floor_cr
    if ests:
        ests.sort()
        est = ests[len(ests) // 2]
    else:
        est = 0
    # 上限取「声明窗口 x 0.95」= 380000，而不是旧的硬 cap 262144：
    # 262144 会让告警永远打印 262144（饱和值），真实水位不可见。
    print(min(max(est, 0), 380000))
PYCTX
)
  case "$CTX" in
    ""|*[!0-9]*) CTX=0 ;;
  esac
  if [ "$CTX" -ge "$MAX_CONTEXT_TOKENS" ]; then
    # 只告警，不打断。压缩负责把上下文压回来，换会话会丢工作记忆。
