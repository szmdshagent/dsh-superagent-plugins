# === preseed guard begin ===
# 预置/克隆会话守卫：某个 sid 的会话文件在「正常生命周期之外」突然变得很大，说明它是被
# 别的脚本整份 cp 进来的（实测 /home/szm/cc-diag/ab-topup.sh 把 52MB 旧会话拷成新 sid，
# 首轮把 42.4M 缓存整体重放，单轮 $29.73）。这种「预置历史」绕过 decide.py 的换会话裁决，
# 必须在这里改名备份，按空会话继续。
# 两个入口都要管，且都不能误伤：
#   - MODE=new：新 uuid 不该有会话文件，有且 ≥阈值就是预置，直接备份；
#   - MODE=resume：正常长会话必须放过，只有「文件首行 sessionId 与本轮 SID 不符」才判定为
#     被 cp 过来的克隆（克隆会继承别人的历史，却用新 sid 记账）。
# 阈值 CC_PRESEED_GUARD_MB（默认 20），总开关 CC_PRESEED_GUARD=0。
PRESEED_MB="${CC_PRESEED_GUARD_MB:-20}"
if [ "${CC_PRESEED_GUARD:-1}" != "0" ]; then
  _PS_OUT="$(python3 - "$DIR" "$SID" "$PRESEED_MB" "$MODE" <<'PYGUARD' 2>/dev/null || echo "skip"
import json, os, sys, time
d, sid, mb, mode = sys.argv[1], sys.argv[2], float(sys.argv[3] or 20), sys.argv[4]
try:
    enc = d.replace("/", "-").replace(".", "-")
    p = os.path.join(os.path.expanduser("~/.claude/projects"), enc, sid + ".jsonl")
    size = os.path.getsize(p)          # 目录不存在/文件不存在都会抛 OSError -> skip
except Exception:
    print("skip"); raise SystemExit(0)
if size < mb * 1048576:
    print("skip"); raise SystemExit(0)
if mode != "new":
    # resume 的大文件通常是正常长会话，不能动。唯一例外是「克隆」：会话文件首行
    # 记的是它出生时的 sessionId，被 cp 过来的文件首行 sid 与本轮 SID 不符。
    try:
        with open(p, encoding="utf-8", errors="replace") as f:
            first = f.readline()
        born = str((json.loads(first) or {}).get("sessionId") or "")
    except Exception:
        born = ""
    if not born or born == sid:
        print("skip"); raise SystemExit(0)
bak = "%s.preseed-%s" % (p, time.strftime("%Y%m%d-%H%M%S"))
try:
    os.replace(p, bak)
except Exception as e:
    print("fail\t%s\t%d\t%s" % (p, size, e)); raise SystemExit(0)
print("moved\t%s\t%d\t%s" % (bak, size, p))
PYGUARD
)"
  case "$_PS_OUT" in
    moved*)
      _PS_BAK="$(printf '%s' "$_PS_OUT" | cut -f2)"
      _PS_SIZE="$(printf '%s' "$_PS_OUT" | cut -f3)"
      # 备份掉预置/克隆文件后，本轮一定按空会话跑：resume 的目标已经不存在了。
      MODE="new"
      echo "$(date -Is) cc-worker: preseed guard: moved pre-seeded session ${_PS_SIZE}B to ${_PS_BAK} (${PRESEED_MB}MB threshold); starting empty session $SID" >> "$BASE/fallback.log"
      echo "cc-worker: 警告——会话 $SID 带预置/克隆历史（${_PS_SIZE} 字节），已改名备份为 $(basename "$_PS_BAK")，本轮按空会话跑" >&2
      ;;
    fail*)
      _PS_ERR="$(printf '%s' "$_PS_OUT" | cut -f4)"
      echo "$(date -Is) cc-worker: preseed guard: rename failed for $SID: ${_PS_ERR}" >> "$BASE/fallback.log"
      ;;
    *)
      ;;
  esac
fi
# === preseed guard end ===

