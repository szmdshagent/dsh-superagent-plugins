      fi
    fi
    if [ "$_dedupe" = 0 ]; then
      printf '%s %s\n' "$_sid" "$(date +%s)" > "$STAMP"
      echo "$(date -Is) cc-worker: context ${CTX} tokens >= alert line ${MAX_CONTEXT_TOKENS}; compaction may not have fired" >> "$BASE/fallback.log"
      echo "cc-worker: 警告——会话上下文约 ${CTX} token，已超警戒线 ${MAX_CONTEXT_TOKENS}，压缩可能没触发" >&2
    fi
  fi
fi


