      python3 "$HOME/cc-diag/decide.py" "$DIR" "$SID" --handoff >/dev/null 2>&1 || true
      SID="$(python3 -c 'import uuid; print(uuid.uuid4())')"
      printf '%s\n' "$SID" > "$SIDF"
      MODE="new"
      python3 "$HOME/cc-diag/decide.py" "$DIR" "$SID" --mark-switched >/dev/null 2>&1 || true
      _SWWHY="$(cat "$BASE/switch-reason" 2>/dev/null || true)"
      echo "$(date -Is) cc-worker: cctrim $_TRIMMED then switch to $SID (reason=${_SWWHY:-?})" >> "$BASE/switch.log"
      ;;
    orphan)
      export CC_ORPHAN="$DIR"
      echo "$(date -Is) cc-worker: orphan dir, reported only (no delete)" >> "$BASE/switch.log"
