{
  "name": "dsh-superagent-pane",
  "version": "0.2.0",
  "description": "给 dsh-superagent 一个「派活」侧边栏：直接输入任务派活、看工单状态与 worker 正在做什么、收结果；含协作分组、僵尸检测与卡死自愈。",
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./tidy": {
      "types": "./lib/tidy.d.ts",
      "default": "./lib/tidy.js"
    },
    "./client": "./lib/client.js",
    "./guard": {
      "types": "./lib/guard.d.ts",
      "default": "./lib/guard.js"
    }
  },
  "files": [
    "lib"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    },
    "manifestVersion": 1
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "superagent",
    "agent"
  ],
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.5-alpha.1",
    "dsh-superagent": "^0.1.0",
    "zod": "*"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.5-alpha.1",
    "@types/node": "22.20.0",
    "@types/react": "18.3.28",
    "@types/react-dom": "18.3.7",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "tsdown": "0.22.14",
    "typescript": "6.0.3"
  },
  "peerDependenciesMeta": {
    "dsh-superagent": {
      "optional": true
    }
  }
}