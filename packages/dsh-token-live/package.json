{
  "name": "dsh-token-live",
  "version": "0.1.0",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "engines": {
    "node": ">=22",
    "dsh": ">=0.2.1-rc.3"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.5"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "~4.0.5",
    "@types/react": "^18.3.0",
    "react": "^18.3.1",
    "tsdown": "^0.22.14",
    "typescript": "^5.6.0"
  },
  "description": "在 dsh Web 界面上实时显示 token 用量：输入/输出/缓存读写与当前会话的上下文占用。",
  "license": "MIT",
  "keywords": [
    "dsh",
    "dsh-plugin"
  ]
}