    {
      "name": "dsh-superagent-executor",
      "title": {
        "en": "dsh-superagent-executor",
        "zh": "dsh-superagent 执行层"
      },
      "description": {
        "en": "Execution layer for dsh-superagent workers: validates cc-worker arguments (turns, lane, team nesting), enforces a per-ticket cost breaker, and aggregates run state per lane. Ships a read-only cc-worker snapshot.",
        "zh": "dsh-superagent worker 的执行层：校验 cc-worker 参数（轮数上限、lane、team 嵌套），按工单执行成本熔断，并按 lane 聚合运行状态；附 cc-worker 只读快照。"
      },
      "author": "szm",
      "homepage": "https://github.com/szmdshagent/dsh-superagent-plugins#readme",
      "repository": {
